# ---------------------------------------------------------------------------
# Plantilla de configuración. Copia este archivo a .env y rellena los valores
# reales. El .env NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# Django exige 50 caracteres como mínimo. Genera una clave válida con:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(64)))"
# Solo letras y numeros: los simbolos como # cortarian la linea de este archivo.
SECRET_KEY=pon-aqui-una-clave-secreta-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=tudominio.com

DB_NAME=paraisocupcake_db
DB_USER=paraisocupcake_user
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=https://tudominio.com
CSRF_TRUSTED_ORIGINS=https://tudominio.com