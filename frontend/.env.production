# ---------------------------------------------------------------------------
# Configuracion del frontend en produccion.
# Vite carga este archivo solo al compilar (npm run build), y sustituye las
# variables VITE_* dentro del codigo. Por eso, cambiar un valor de aqui exige
# reconstruir la imagen del frontend; no basta con reiniciar el contenedor.
#
# Este archivo NO contiene secretos: todo lo que hay aqui acaba dentro del
# JavaScript que descarga el navegador. Por eso si se sube al repositorio.
# ---------------------------------------------------------------------------

# Modo de venta de la tienda. ESTE ES EL INTERRUPTOR.
#   false -> catalogo: sin precios, sin carrito, sin checkout.
#   true  -> tienda online completa, como estaba antes.
VITE_MOSTRAR_PRECIOS=false

# Contactos del boton "Precio a consultar". Provisionales.
VITE_WHATSAPP=+584127825317
